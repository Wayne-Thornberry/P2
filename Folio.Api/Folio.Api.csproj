<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Folio.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL Server is the only provider. The schema is the database project's, so
         the app maps tables that scripts created and never creates one itself. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Folio.Api.Tests" />
  </ItemGroup>

</Project>
