{
  // No connection string here on purpose. A local run has no database: the site talks to
  // the mock API in Folio.Web\mocks, and the deploy writes a real connection string into
  // appsettings.Production.json on the box. To run the real API locally, put one in
  // appsettings.Development.json (gitignored) and start it with `.\start.ps1 -Api`.

  "Auth": {
    // The one account. The password is deliberately empty: nothing is seeded until
    // a password is configured, so a checkout never ships with a working login.
    // start.ps1 sets one for its throwaway database, and the deploy writes a real one
    // into appsettings.Production.json from a secret.
    "SeedUsername": "wayne",
    "SeedPassword": "",

    // The word that replaces a forgotten password from the sign-in page. Empty here, so a
    // checkout cannot be reset from outside at all; start.ps1 sets one locally and the
    // deploy writes the RECOVERY_CODE secret into appsettings.Production.json.
    "RecoveryCode": "",

    "SessionDays": 30
  },

  "Cors": {
    // Origins allowed to call the API. The portal and its modules are one origin, so
    // this normally holds one entry written by the deploy. Loopback and private
    // addresses are always allowed, which is what makes http://localhost:5420 and a
    // LAN address work without configuring anything.
    "AllowedOrigins": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
