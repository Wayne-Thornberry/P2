{
  "ConnectionStrings": {
    // The LocalDB instance a fresh clone can use. start.ps1 creates it and applies
    // the database scripts to it; nothing here is shared with anything else.
    "Default": "Server=(localdb)\\Folio;Database=Folio;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Ai": {
    "DeepSeek": {
      // The key behind the two AI features: the report on the Reports page, and the
      // categorising on the Transactions page. Empty here, so a checkout has no AI and no
      // page offers it; the deploy writes the DEEPSEEK_API_KEY secret into
      // appsettings.Production.json, and start.ps1 passes the environment's own through.
      "ApiKey": "",
      "Model": "deepseek-flash"
    }
  },

  "Cors": {
    // Origins allowed to call the API. The portal and its modules are one origin, so
    // this normally holds one entry written by the deploy. Loopback and private
    // addresses are always allowed, which is what makes http://localhost:5420 and a
    // LAN address work without configuring anything.
    "AllowedOrigins": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
