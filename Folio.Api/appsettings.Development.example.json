{
  // Template for appsettings.Development.json, which is gitignored: the shared box
  // needs a login, and a login does not belong in the repository.
  //
  //   Copy-Item appsettings.Development.example.json appsettings.Development.json
  //
  // Then fill in the server and, if the box wants a SQL login rather than Windows
  // authentication, the user and password. start.ps1 -Dev reads this file, so
  // nothing else has to be pointed anywhere.
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Folio;User Id=Folio;Password=;TrustServerCertificate=True"
  }
}
