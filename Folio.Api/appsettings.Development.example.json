{
  // Template for appsettings.Development.json, which is gitignored: it names a real
  // server, and that does not belong in the repository.
  //
  //   Copy-Item appsettings.Development.example.json appsettings.Development.json
  //   .\start.ps1 -Api
  //
  // You do not need this to develop. A plain .\start.ps1 runs the site against its mock
  // API, with a full example budget and no database at all. This file is for the rarer
  // case of running the real API against a database that has already been deployed.
  //
  // Windows authentication if you leave out User Id and Password. If the server wants a
  // SQL login instead, fill both in -- but this project's own deploy never creates one.
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Folio;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
