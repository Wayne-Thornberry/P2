<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the site.

  One single-page app, so a deep link such as /folio is answered with its index.html
  rather than looked up as a file on disk. Every module is a route inside that app, not
  a folder of its own, so this is the only rewrite rule there is.

  Only URL Rewrite is needed. The browser calls the API on its own port directly rather
  than through a rewrite here, so there is no dependency on Application Request Routing.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="App routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Nothing here is kept. The bundles are hashed, so the tempting thing is a year of
      caching on them, but index.html is what names them: a browser holding a year-old
      index.html asks for a bundle the last deploy deleted. A page that reloads is a page
      that works, and this box is on a LAN.

      Said with `no-store` on every response rather than IIS's own `clientCache`, because
      that element can only ever say `no-cache`: revalidate, and keep a copy anyway. Two
      of the headers below also carry that meaning for a proxy that reads HTTP/1.0.

      Do not add a clientCache element beside this: it writes a second Cache-Control and
      the two are then read as one, which is exactly the sort of thing nobody notices until
      a stale page is blamed on the app.
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
        <remove name="Pragma" />
        <add name="Pragma" value="no-cache" />
        <remove name="Expires" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>

    <!--
      IIS can answer out of its own output cache, and a rule there would outlive both the
      headers above and the deploy that changed the files. There are no rules on this box
      today; saying it here means adding one is a change to this file rather than a
      setting nobody looked at.
    -->
    <caching enabled="false" enableKernelCache="false" />

    <staticContent>
      <!--
        pdf.js reads a statement in a worker, and the worker ships as a .mjs module. IIS
        has no MIME map for that extension, so it answers 404 and the reader never starts:
        "Setting up fake worker failed", with the file sitting there in the folder.
        The remove comes first so a server that already maps .mjs is not a duplicate entry,
        which is a 500 on every request rather than one broken import.
      -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
  </system.webServer>
</configuration>
