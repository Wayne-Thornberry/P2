<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the site.

  One single-page app, so a deep link such as /folio is answered with its index.html
  rather than looked up as a file on disk. Every module is a route inside that app, not
  a folder of its own, so this is the only rewrite rule there is.

  Only URL Rewrite is needed. The browser calls the API on its own port directly rather
  than through a rewrite here, so there is no dependency on Application Request Routing.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="App routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Nothing here is kept. The bundles are hashed, so the tempting thing is a year of
      caching on them, but index.html is what names them: a browser holding a year-old
      index.html asks for a bundle the last deploy deleted. A page that reloads is a page
      that works, and this box is on a LAN.
    -->
    <staticContent>
      <!--
        pdf.js reads a statement in a worker, and the worker ships as a .mjs module. IIS
        has no MIME map for that extension, so it answers 404 and the reader never starts:
        "Setting up fake worker failed", with the file sitting there in the folder.
        The remove comes first so a server that already maps .mjs is not a duplicate entry,
        which is a 500 on every request rather than one broken import.
      -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />

      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
